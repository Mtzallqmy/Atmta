      "id": "summary", "name": "Load Daily Summary", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-320, 0],
      "credentials": { "supabaseApi": { "id": "REPLACE_SUPABASE_CREDENTIAL_ID", "name": "Atmta Supabase" } }
