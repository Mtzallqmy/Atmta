      "id": "send", "name": "Send Daily Summary", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [160, 0],
      "credentials": { "telegramApi": { "id": "REPLACE_TELEGRAM_CREDENTIAL_ID", "name": "Atmta Telegram Bot" } }
