{
  "name": "Atmta 07 - Daily Summary",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 20 * * *" }] } }, "id": "schedule", "name": "Daily at 20:00", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-560, 0] },
    {
