# General
APP_TIMEZONE=Asia/Aden

# Supabase Cloud
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Trusted n8n only. Do not expose to a browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# Meta
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Set explicitly to the currently supported Graph API version after checking Meta docs.
META_GRAPH_API_VERSION=
META_PAGE_ACCESS_TOKEN=

# n8n API (optional; only for automated workflow deployment)
N8N_BASE_URL=
N8N_API_KEY=

# Local Agent
AGENT_ID=primary
AGENT_POLL_INTERVAL_SECONDS=30
AGENT_BROWSER_HEADLESS=false
